{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "infernoctf-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": false
        },
        "@schematics/angular:directive": {
          "standalone": false
        },
        "@schematics/angular:pipe": {
          "standalone": false
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/app",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles.scss",
              "node_modules/material-icons/iconfont/material-icons.scss",
              "src/styles/material-styles.scss",
              "src/styles/app-styles.scss",
              "src/styles/common/dist/css/common-styles.min.css"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "node_modules/@angular/material/"
              ],
              "sass": {
                "silenceDeprecations": [
                  "color-functions",
                  "global-builtin",
                  "if-function",
                  "import"
                ]
              }
            },
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "2.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kB",
                  "maximumError": "28kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "infernoctf-web:build:production"
            },
            "development": {
              "buildTarget": "infernoctf-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "infernoctf-web:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles.scss",
              "node_modules/material-icons/iconfont/material-icons.scss",
              "src/styles/material-styles.scss",
              "src/styles/app-styles.scss",
              "src/styles/common/dist/css/common-styles.min.css"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "node_modules/@angular/material/"
              ],
              "sass": {
                "silenceDeprecations": [
                  "color-functions",
                  "global-builtin",
                  "if-function",
                  "import"
                ]
              }
            },
            "scripts": []
          }
        }
      }
    }
  }
}
